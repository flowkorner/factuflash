# Copier ce fichier en .env.local et remplir les valeurs (Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://<ref-du-projet>.supabase.co
# Clé "Publishable" (sb_publishable_...) ou, ancien format, clé "anon public".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL du site, utilisée dans le lien de l'email (sans / final).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Emails (serveur uniquement, jamais NEXT_PUBLIC_) ---
# Clé API Resend (resend.com → API Keys), droits « Sending access ».
RESEND_API_KEY=
# Expéditeur. Sans domaine vérifié chez Resend : onboarding@resend.dev.
EMAIL_FROM=FactuFlash <onboarding@resend.dev>
# Mode test : tous les emails partent vers cette adresse (Resend sans domaine vérifié
# n'accepte que l'adresse du compte). Laisser vide en production.
EMAIL_TEST_RECIPIENT=flowkorner@gmail.com
